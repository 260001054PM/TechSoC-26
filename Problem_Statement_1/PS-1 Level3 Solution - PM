import copy
import os
import time


R, C = map(int, input().split())
G = int(input())
delay = float(input())

grid = []
temp = ["."] * (C + 2)
grid.append(temp)

for i in range(R):
    a = ["."] + list(input().split()) + ["."]
    grid.append(a)
grid.append(temp)

os.system("cls" if os.name == "nt" else "clear")
popu = sum(row.count("#") for row in grid)
print(f"Generation: 0 Population: {popu}")
for tp in range(1, R + 1):
    print(" ".join(grid[tp][1 : C + 1]))
time.sleep(delay)

for jk in range(1, G + 1):
    grid2 = copy.deepcopy(grid)

    for i in range(1, R + 1):
        for j in range(1, C + 1):
            deadlist = [
                grid[i + 1][j - 1],
                grid[i - 1][j],
                grid[i][j + 1],
                grid[i][j - 1],
                grid[i - 1][j - 1],
                grid[i - 1][j + 1],
                grid[i + 1][j],
                grid[i + 1][j + 1],
            ]
            living = deadlist.count("#")

            if grid[i][j] == "#":
                if living < 2 or living > 3:
                    grid2[i][j] = "."
            else:
                if living == 3:
                    grid2[i][j] = "#"

    grid = grid2

    os.system("cls" if os.name == "nt" else "clear")
    popu = sum(row.count("#") for row in grid)
    print(f"Generation: {jk} Population: {popu}")
    for tp in range(1, R + 1):
        print(" ".join(grid[tp][1 : C + 1]))

    time.sleep(delay)
